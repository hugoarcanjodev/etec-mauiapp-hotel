<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout VerticalOptions="Center"
                         HorizontalOptions="Center"
                         WidthRequest="380"
                         Padding="20"
                         Spacing="16">

        <Label Text="Cálculo da Diária"
               FontFamily="Boogaloo"
               FontSize="44"
               HorizontalTextAlignment="Center"
               TextColor="{StaticResource Primary}"
               Margin="0,0,0,8" />

        <Border StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                Padding="20"
                BackgroundColor="{StaticResource Gray900}">

            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.15" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="16">

                <Grid RowDefinitions="Auto, Auto"
                      ColumnDefinitions="*, *, 2*"
                      RowSpacing="14">

                    <Label Grid.Row="0" Grid.Column="0"
                           VerticalTextAlignment="Center"
                           FontAttributes="Bold"
                           TextColor="White"
                           Text="Adultos:" />

                    <Label Grid.Row="0" Grid.Column="1"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{StaticResource Primary}"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_adultos}"/>

                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stp_adultos"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"
                             HorizontalOptions="End" />

                    <Label Grid.Row="1" Grid.Column="0"
                           VerticalTextAlignment="Center"
                           FontAttributes="Bold"
                           TextColor="White"
                           Text="Crianças:" />

                    <Label Grid.Row="1" Grid.Column="1"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="Center"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="{StaticResource Primary}"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_criancas}"/>

                    <Stepper Grid.Row="1" Grid.Column="2"
                             x:Name="stp_criancas"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"
                             HorizontalOptions="End" />
                </Grid>

                <Border StrokeThickness="1"
                        Stroke="{StaticResource Gray600}"
                        StrokeShape="RoundRectangle 12"
                        Padding="14" 
                        Margin="0,4"
                        BackgroundColor="#1e222b">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Escolha sua Suíte"
                               TextTransform="Uppercase"
                               FontSize="12"
                               FontAttributes="Bold"
                               CharacterSpacing="1"
                               TextColor="{StaticResource Primary}"/>

                        <Picker x:Name="pck_quarto"
                                Title="Selecione sua Acomodação"
                                TitleColor="{StaticResource Gray400}"
                                TextColor="White"
                                ItemDisplayBinding="{Binding Descricao}"/>
                    </VerticalStackLayout>
                </Border>

                <Border StrokeThickness="1"
                        Stroke="{StaticResource Gray600}"
                        StrokeShape="RoundRectangle 12"
                        Padding="14"
                        Margin="0,4"
                        BackgroundColor="#1e222b">

                    <VerticalStackLayout Spacing="12">
                        <Label Text="Período da Estadia"
                               TextTransform="Uppercase"
                               FontSize="12"
                               FontAttributes="Bold"
                               CharacterSpacing="1"
                               TextColor="{StaticResource Primary}"/>

                        <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="Check-in:" VerticalTextAlignment="Center" TextColor="White" />
                            <DatePicker x:Name="dtpck_checkin"
                                        DateSelected="dtpck_checkin_DateSelected"
                                        TextColor="White"
                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Label Text="Check-out:" VerticalTextAlignment="Center" TextColor="White" />
                            <DatePicker x:Name="dtpck_checkout"
                                        TextColor="White"
                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Avançar" 
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="48"
                        CornerRadius="10"
                        Margin="0,12,0,0" 
                        Clicked="Button_Clicked" />

            </VerticalStackLayout>
        </Border>

        <Button Text="Sobre o Aplicativo"
                TextColor="{StaticResource Primary}"
                BackgroundColor="White"
                BorderColor="{StaticResource Primary}"
                BorderWidth="1"
                FontAttributes="Bold"
                HeightRequest="48"
                CornerRadius="10"
                Margin="0,16,0,0" 
                HorizontalOptions="Center"
                Clicked="Button_Sobre_Clicked" />

    </VerticalStackLayout>
</ContentPage>
