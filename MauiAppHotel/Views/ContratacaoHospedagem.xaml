<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="ContratacaoHospedagem"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout VerticalOptions="Center"
                         HorizontalOptions="Center"
                         WidthRequest="380"
                         Padding="10"
                         Spacing="10">

        <Label Text="Cálculo da Diária"
               FontFamily="Boogaloo"
               FontSize="50"
               HorizontalTextAlignment="Center"
               TextColor="{StaticResource Primary}" />

        <Border StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                Padding="10"
                BackgroundColor="{StaticResource Gray900}">
            <VerticalStackLayout Spacing="10">
                <Grid RowDefinitions="Auto, Auto"
                      ColumnDefinitions="*, *, 2*"
                      RowSpacing="10">

                    <Label Grid.Row="0" Grid.Column="0"
                           VerticalTextAlignment="Center"
                           TextColor="{StaticResource Secondary}"
                           Text="Adultos:" />

                    <Label Grid.Row="0" Grid.Column="1"
                           VerticalTextAlignment="Center"
                           TextColor="{StaticResource Primary}"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_adultos}"/>

                    <Stepper Grid.Row="0" Grid.Column="2"
                             x:Name="stp_adultos"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"
                             BackgroundColor="{StaticResource Gray900}"/>

                    <Label Grid.Row="1" Grid.Column="0"
                           VerticalTextAlignment="Center"
                           TextColor="{StaticResource Secondary}"
                           Text="Crianças:" />

                    <Label Grid.Row="1" Grid.Column="1"
                           VerticalTextAlignment="Center"
                           TextColor="{StaticResource Primary}"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_criancas}"/>

                    <Stepper Grid.Row="1" Grid.Column="2"
                             x:Name="stp_criancas"
                             Minimum="0"
                             Maximum="10"
                             Increment="1"
                             BackgroundColor="{StaticResource PrimaryDarkText}"/>
                </Grid>

                <Border StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="10" 
                        Margin="0,5"
                        BackgroundColor="{StaticResource Gray900}">
                    <VerticalStackLayout Spacing="5">

                        <Label Text="Escolha sua Suíte"
                               TextTransform="Uppercase"
                               FontSize="Subtitle"
                               TextColor="{StaticResource Primary}"/>

                        <Picker x:Name="pck_quarto"
                                Title="Selecione sua Acomodação"
                                ItemDisplayBinding="{Binding Descricao}"/>
                    </VerticalStackLayout>
                </Border>

                <Border StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="10"
                        Margin="0,5"
                        BackgroundColor="{StaticResource Gray900}">
                    <VerticalStackLayout Spacing="10">

                        <Label Text="Período da Estadia"
                               TextTransform="Uppercase"
                               FontSize="Subtitle"
                               TextColor="{StaticResource Primary}"/>

                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Label Text="Check-in:" VerticalTextAlignment="Center" />
                            <DatePicker x:Name="dtpck_checkin"
                                        DateSelected="dtpck_checkin_DateSelected"
                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Label Text="Check-out:" VerticalTextAlignment="Center" />
                            <DatePicker x:Name="dtpck_checkout"
                                        Format="dd/MM/yyyy" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Avançar" Margin="0,10,0,0" Clicked="Button_Clicked" />

            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>
</ContentPage>
