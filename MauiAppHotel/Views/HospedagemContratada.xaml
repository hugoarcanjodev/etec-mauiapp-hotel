<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.HospedagemContratada"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout VerticalOptions="CenterAndExpand"
                         HorizontalOptions="Center"
                         WidthRequest="380"
                         Padding="20"
                         Spacing="12">

        <Label Text="Suíte Super Luxo"
               FontFamily="Boogaloo"
               FontSize="44"
               HorizontalTextAlignment="Center"
               TextColor="{StaticResource Primary}"
               Margin="0,0,0,8" />

        <Frame Margin="0,4"
               Padding="16,14"
               CornerRadius="12"
               BorderColor="{StaticResource Gray600}"
               BackgroundColor="{StaticResource Gray900}">

            <Frame.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.1" />
            </Frame.Shadow>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="24">
                <HorizontalStackLayout Spacing="6">
                    <Label Text="Adultos:" 
                           FontAttributes="Bold" 
                           TextColor="White" 
                           VerticalTextAlignment="Center" />
                    <Label Text="2" 
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" 
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="6">
                    <Label Text="Crianças:" 
                           FontAttributes="Bold" 
                           TextColor="White" 
                           VerticalTextAlignment="Center" />
                    <Label Text="1" 
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" 
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </Frame>

        <Frame Margin="0,4"
               Padding="16"
               CornerRadius="12"
               BorderColor="{StaticResource Gray600}"
               BackgroundColor="{StaticResource Gray900}">

            <Frame.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.1" />
            </Frame.Shadow>

            <Grid ColumnDefinitions="*, *, *"
                  RowDefinitions="Auto, Auto"
                  RowSpacing="8"
                  ColumnSpacing="10">

                <Label Grid.Row="0" Grid.Column="0" Text="Check-in" FontSize="11" TextColor="{StaticResource Gray400}" HorizontalTextAlignment="Center" />
                <Label Grid.Row="0" Grid.Column="1" Text="Check-out" FontSize="11" TextColor="{StaticResource Gray400}" HorizontalTextAlignment="Center" />
                <Label Grid.Row="0" Grid.Column="2" Text="Estadia" FontSize="11" TextColor="{StaticResource Gray400}" HorizontalTextAlignment="Center" />

                <Label Grid.Row="1" Grid.Column="0" Text="27/05/2026" FontAttributes="Bold" FontSize="14" TextColor="White" HorizontalTextAlignment="Center" />
                <Label Grid.Row="1" Grid.Column="1" Text="30/05/2026" FontAttributes="Bold" FontSize="14" TextColor="White" HorizontalTextAlignment="Center" />
                <Label Grid.Row="1" Grid.Column="2" Text="3" FontAttributes="Bold" FontSize="14" TextColor="{StaticResource Primary}" HorizontalTextAlignment="Center" />
            </Grid>
        </Frame>

        <Frame Margin="0,4"
               Padding="16,14"
               CornerRadius="12"
               BorderColor="{StaticResource Gray600}"
               BackgroundColor="#1e222b">

            <Frame.Shadow>
                <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.1" />
            </Frame.Shadow>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                <HorizontalStackLayout>
                    <Label Text="Valor Total: " 
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="White" 
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>

                <HorizontalStackLayout>
                    <Label Text="R$: 750,00" 
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" 
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </Frame>

        <Button Text="Voltar" 
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                FontAttributes="Bold"
                HeightRequest="48"
                WidthRequest="160"
                CornerRadius="10"
                Margin="0,16,0,0"
                HorizontalOptions="Center"
                Clicked="Button_Clicked" />

    </VerticalStackLayout>
</ContentPage>
