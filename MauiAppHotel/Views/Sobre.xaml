<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre o App"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout VerticalOptions="Center"
                         HorizontalOptions="Center"
                         WidthRequest="380"
                         Padding="20"
                         Spacing="15">

        <Label Text="Sobre o App"
               FontFamily="Boogaloo"
               FontSize="50"
               HorizontalTextAlignment="Center"
               TextColor="{StaticResource Primary}" />

        <Border StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                Padding="20"
                BackgroundColor="{StaticResource Gray900}">

            <VerticalStackLayout Spacing="15" HorizontalOptions="Center">

                <Label Text="🏨" 
                       FontSize="60" 
                       HorizontalTextAlignment="Center" />

                <Label Text="HotelApp .NET MAUI"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource Primary}" />

                <Label Text="Aplicativo desenvolvido no curso Técnico em Desenvolvimento de Sistemas da ETEC."
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource Secondary}" />

                <BoxView HeightRequest="1" 
                         BackgroundColor="{StaticResource Gray600}" 
                         Margin="0,5" />

                <VerticalStackLayout Spacing="5">
                    <Label Text="Desenvolvedor:"
                           FontSize="12"
                           TextColor="{StaticResource Secondary}"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Hugo Arcanjo"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="5">
                    <Label Text="Ano de Desenvolvimento:"
                           FontSize="12"
                           TextColor="{StaticResource Secondary}"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="2026"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>

        <Button Text="Voltar" 
                Margin="0,10,0,0" />

    </VerticalStackLayout>
</ContentPage>