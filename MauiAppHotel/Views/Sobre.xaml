<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre o App"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <VerticalStackLayout VerticalOptions="Center"
                         HorizontalOptions="Center"
                         WidthRequest="380"
                         Padding="20"
                         Spacing="16">

        <Label Text="Sobre o App"
               FontFamily="Boogaloo"
               FontSize="44"
               HorizontalTextAlignment="Center"
               TextColor="{StaticResource Primary}"
               Margin="0,0,0,8" />

        <Border StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                Padding="24,20"
                BackgroundColor="{StaticResource Gray900}">

            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,10" Radius="20" Opacity="0.15" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="16" HorizontalOptions="Center">

                <Label Text="🏨" 
                       FontSize="64" 
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,4" />

                <Label Text="HotelApp .NET MAUI"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="{StaticResource Primary}" />

                <Label Text="Aplicativo desenvolvido no curso Técnico em Desenvolvimento de Sistemas da ETEC."
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       TextColor="White" />

                <BoxView HeightRequest="1" 
                         Color="{StaticResource Gray600}" 
                         HorizontalOptions="Fill"
                         Margin="0,4" />

                <VerticalStackLayout Spacing="4">
                    <Label Text="Desenvolvedor"
                           FontSize="12"
                           FontAttributes="Bold"
                           CharacterSpacing="1"
                           TextTransform="Uppercase"
                           TextColor="{StaticResource Gray400}"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Hugo Arcanjo"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Ano de Desenvolvimento"
                           FontSize="12"
                           FontAttributes="Bold"
                           CharacterSpacing="1"
                           TextTransform="Uppercase"
                           TextColor="{StaticResource Gray400}"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="2026"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Border>

        <Button Text="Voltar" 
                BackgroundColor="{StaticResource Primary}"
                TextColor="White"
                FontAttributes="Bold"
                HeightRequest="48"
                WidthRequest="160"
                CornerRadius="10"
                Margin="0,12,0,0"
                HorizontalOptions="Center"
                Clicked="Button_Clicked"/>

    </VerticalStackLayout>
</ContentPage>
